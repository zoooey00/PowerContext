# Local single-user defaults. Do not commit real tokens.
POWERCONTEXT_SERVER_URL=http://127.0.0.1:18080
# Empty: create/reuse a real Scope via the official API.
POWERCONTEXT_SCOPE_ID=
# Use a different key for a separate local project/user.
POWERCONTEXT_SCOPE_KEY=workflow-ai-personal-v1
POWERCONTEXT_API_TOKEN=
# FTS needs no model key. Hybrid/vector requires server embedding configuration.
POWERCONTEXT_SEARCH_MODE=fts
# Set true only if using an already deployed external PowerContext server.
POWERCONTEXT_EXTERNAL=false
LOCAL_POWERCONTEXT_PORT=18080
APP_HOST=127.0.0.1
APP_PORT=8000
# DATABASE_PATH defaults to this project's data/workflow.db
